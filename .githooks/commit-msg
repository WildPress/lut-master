#!/bin/sh
# Enforces Conventional Commits: type(scope)?!?: subject, header up to 72 chars.
msg_file="$1"
header=$(sed -n '1p' "$msg_file")

case "$header" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: .+'
if ! printf '%s\n' "$header" | grep -Eq "$pattern"; then
  echo "commit-msg: header must look like 'type(scope): subject'." >&2
  echo "types: feat fix docs style refactor perf test build ci chore revert" >&2
  exit 1
fi

if [ "$(printf '%s' "$header" | wc -c)" -gt 72 ]; then
  echo "commit-msg: header is longer than 72 characters." >&2
  exit 1
fi
