<?xml version="1.0" encoding="utf-8"?>
<!-- The selected layer (the one the looks grid fills) gets a light grey outline. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/grey_raised" />
            <stroke android:width="1.5dp" android:color="@color/grey_selected" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_container_high" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
