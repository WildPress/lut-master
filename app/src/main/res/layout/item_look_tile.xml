<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    android:checkable="true"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/surface_container_high"
    app:cardCornerRadius="10dp"
    app:cardElevation="0dp"
    app:cardForegroundColor="@android:color/transparent"
    app:checkedIcon="@null"
    app:strokeColor="@color/card_stroke_color"
    app:strokeWidth="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Square whatever the video's shape; the frame is centre-cropped to fit. -->
        <app.lutapply.SquareFrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/thumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/surface_container_highest"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

            <ImageButton
                android:id="@+id/star"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="top|end"
                android:layout_margin="4dp"
                android:background="@drawable/star_bg"
                android:contentDescription="@string/favourite"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_star_border" />
        </app.lutapply.SquareFrameLayout>

        <TextView
            android:id="@+id/lookName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:minLines="2"
            android:paddingHorizontal="6dp"
            android:paddingVertical="4dp"
            android:textColor="?colorOnSurface"
            android:textSize="11sp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
