<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface_container"
        app:menu="@menu/overflow"
        app:title="@string/app_name"
        app:titleTextColor="?colorOnSurface">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:gravity="center_vertical"
            android:orientation="horizontal">

        <!-- Only shown once there's a video and a look to export. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/export"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingHorizontal="16dp"
            android:text="@string/export"
            android:textColor="@color/export_button_fg"
            android:visibility="gone"
            app:backgroundTint="@color/export_button_bg"
            app:icon="@android:drawable/ic_menu_save"
            app:iconGravity="textStart"
            app:iconTint="@color/export_button_fg" />

        <!-- Opening a video, spelled out: an icon alone wasn't clear enough. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/openVideo"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingHorizontal="14dp"
            android:text="@string/open_short"
            app:icon="@drawable/ic_folder_open"
            app:iconGravity="textStart" />
        </LinearLayout>
    </com.google.android.material.appbar.MaterialToolbar>

    <app.lutapply.HoldToCompareLayout
        android:id="@+id/playerHolder"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3"
        android:background="@color/viewer_surround">

        <androidx.media3.ui.PlayerView
            android:id="@+id/player"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:auto_show="false"
            app:resize_mode="fit"
            app:shutter_background_color="@color/viewer_surround"
            app:show_buffering="when_playing"
            app:show_fastforward_button="false"
            app:show_next_button="false"
            app:show_previous_button="false"
            app:show_rewind_button="false"
            app:show_shuffle_button="false"
            app:show_subtitle_button="false"
            app:show_timeout="3000"
            app:surface_type="texture_view"
            app:use_controller="true" />

        <TextView
            android:id="@+id/compareBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="12dp"
            android:background="@drawable/badge_bg"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="@string/original_badge"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/referenceBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:background="@drawable/badge_bg"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:text="@string/reference_badge"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp"
            android:visibility="gone" />

        <!-- Status and export progress sit over the video so they never change its size. -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:max="100"
            android:visibility="gone"
            app:trackCornerRadius="0dp" />

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="8dp"
            android:background="@drawable/badge_bg"
            android:maxLines="3"
            android:ellipsize="end"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:visibility="gone" />
    </app.lutapply.HoldToCompareLayout>

    <!-- Everything under the video shares this fixed share of the screen, so the video never
         changes size when the layers panel or the camera row appear. They take room from the grid. -->
    <LinearLayout
        android:id="@+id/controlsArea"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/profileRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:background="@color/surface_container"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/camera_label"
                android:textColor="?colorOnSurfaceVariant"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/profileButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:maxLines="1"
                app:icon="@drawable/ic_arrow_drop_down"
                app:iconGravity="end" />
        </LinearLayout>

        <!-- Hidden until a look is picked. A single row: layer pills (scrolling if there are many),
             the selected layer's strength, and add. Same height however many layers there are. -->
        <LinearLayout
            android:id="@+id/layersPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface_container"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:visibility="gone">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/layersList"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:clipToPadding="false"
                android:overScrollMode="never" />

            <com.google.android.material.slider.Slider
                android:id="@+id/strength"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:contentDescription="@string/strength_label"
                android:stepSize="5"
                android:value="100"
                android:valueFrom="0"
                android:valueTo="100"
                app:labelBehavior="floating"
                app:thumbHeight="24dp"
                app:tickVisible="false"
                app:trackHeight="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/addLayer"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@string/add_layer"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_add"
                app:iconTint="?colorOnSurface" />
        </LinearLayout>

        <!-- The category bar floats over the top of the looks list, which is padded by the bar's
             height. Hiding the bar while scrolling slides it away without resizing the list, so
             the scroll under the finger isn't disturbed. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/looksList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="8dp"
                android:paddingBottom="8dp" />

            <HorizontalScrollView
                android:id="@+id/chipScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:colorBackground"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/categoryChips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="12dp"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true" />
            </HorizontalScrollView>
        </FrameLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/debug"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_container"
        android:paddingHorizontal="16dp"
        android:paddingBottom="4dp"
        android:textColor="@color/on_surface_dim"
        android:textSize="11sp"
        android:visibility="gone" />
</LinearLayout>
