<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Cat Daddy house theme: ink background, ginger accent, teal second colour. -->
    <style name="Theme.LutMaster" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/cd_ginger</item>
        <item name="colorOnPrimary">#FF2B1300</item>
        <item name="colorPrimaryContainer">#FF6B3500</item>
        <item name="colorOnPrimaryContainer">#FFFFDCC6</item>
        <item name="colorSecondary">@color/cd_teal</item>
        <item name="colorOnSecondary">#FF003738</item>
        <item name="colorSecondaryContainer">#FF2C3A40</item>
        <item name="colorOnSecondaryContainer">#FFCDEFF0</item>
        <item name="colorTertiary">#FFE6C3A0</item>
        <item name="colorOnTertiary">#FF3F2D17</item>
        <item name="colorTertiaryContainer">#FF57432B</item>
        <item name="colorOnTertiaryContainer">#FFFFDDBA</item>
        <item name="colorError">#FFFFB4AB</item>
        <item name="colorOnError">#FF690005</item>
        <item name="colorSurface">@color/cd_ink</item>
        <item name="colorOnSurface">#FFEAE3DA</item>
        <item name="colorSurfaceVariant">#FF46424F</item>
        <item name="colorOnSurfaceVariant">#FFCBC4D2</item>
        <item name="colorOutline">#FF948F9C</item>
        <item name="colorSurfaceContainer">@color/surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/surface_container_highest</item>
        <item name="android:colorBackground">@color/cd_ink</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Splash screen: the app's cat on ink. Android 12+ adds the name and "by Cat Daddy"
         underneath (values-v31). -->
    <style name="Theme.LutMaster.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/cd_ink</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.LutMaster</item>
    </style>
</resources>
