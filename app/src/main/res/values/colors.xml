<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Cat Daddy brand colours, shared by every app (see cat-daddy-brand/README.md). LUT Master
         only uses them on the splash screen: while grading, any colour around the picture skews
         how it's judged, so the app itself is strictly neutral grey (R = G = B everywhere),
         like a grading suite. -->
    <color name="cd_ink">#FF15131C</color>
    <color name="cd_cream">#FFF4EADB</color>
    <color name="cd_ginger">#FFFF8A34</color>
    <color name="cd_teal">#FF5ED5D8</color>

    <!-- Black: the preview pipeline letterboxes the frame in black itself, so the viewer matches it
         before a video loads too. -->
    <color name="viewer_surround">#FF000000</color>
    <color name="grey_bg">#FF1C1C1C</color>
    <color name="surface_container">#FF242424</color>
    <color name="surface_container_high">#FF2E2E2E</color>
    <color name="surface_container_highest">#FF383838</color>
    <color name="grey_raised">#FF3A3A3A</color>
    <color name="grey_text">#FFDADADA</color>
    <color name="grey_text_bright">#FFEDEDED</color>
    <color name="grey_selected">#FFC8C8C8</color>
    <color name="on_surface_dim">#FF8A8A8A</color>
    <color name="section_header">#FF8A8A8A</color>
</resources>
